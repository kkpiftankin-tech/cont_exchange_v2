ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION} AS builder

# Base build tools + deps for gRPC/protobuf + Kafka + Boost
# F-05A / ADR-048 §7: OSQP (matching QP solver) — через CMake FetchContent (pinned
# v0.6.3); apt-пакет не нужен, но нужны git + сеть на configure (см. ниже) и Eigen
# (libeigen3-dev). Держать синхронно с matching CMake и .github/workflows/cpp-build.yml.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential cmake pkg-config git \
    libgrpc++-dev protobuf-compiler-grpc libprotobuf-dev \
    libabsl-dev \
    libeigen3-dev \
    librdkafka-dev \
    libcurl4-openssl-dev \
    libpq-dev libpqxx-dev \
    libboost-all-dev \
    libasio-dev \
    nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

ARG BUILD_JOBS=1
ARG TARGET

# Build a requested binary target when provided; otherwise build the full tree for ctest.
RUN cmake -S . -B /tmp/build -DCMAKE_BUILD_TYPE=Release
RUN if [ -n "${TARGET}" ]; then \
      cmake --build /tmp/build --parallel "${BUILD_JOBS}" --target "${TARGET}"; \
    else \
      cmake --build /tmp/build --parallel "${BUILD_JOBS}"; \
    fi

FROM ubuntu:${UBUNTU_VERSION} AS runtime

# Runtime deps (keep simple for MVP: install same packages).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libgrpc++-dev libprotobuf-dev \
    libabsl-dev \
    libeigen3-dev \
    librdkafka-dev \
    libcurl4 \
    libpq5 libpqxx-dev \
    libboost-all-dev \
    && rm -rf /var/lib/apt/lists/*

ARG TARGET
COPY --from=builder /tmp/build/bin/${TARGET} /usr/local/bin/${TARGET}
RUN ln -sf /usr/local/bin/${TARGET} /usr/local/bin/service

ENV TZ=UTC
ENTRYPOINT ["/usr/local/bin/service"]
