# --- Kafka/Redpanda ---
KAFKA_BROKERS=redpanda:9092
REPLAY_COMMANDS_TOPIC=replay.commands
REPLAY_RESULTS_TOPIC=replay.results

# --- F-15 replay RBAC (gateway + backtest) ---
# Defaults to true (secure) in code. Dev/demo runs with enforcement OFF until
# per-user replay roles are seeded; flip to true once roles/users are loaded.
REPLAY_RBAC_ENFORCEMENT=false

# --- F-15 replay SSE hardening (gateway, T-F15-007) ---
# REPLAY_GW_THREADS: Crow worker pool size for the gateway.
# REPLAY_SSE_MAX_STREAMS: max concurrent /results/stream long-poll connections
#   (kept below the pool so REST endpoints always keep headroom).
# REPLAY_SSE_MAX_DURATION_S: max time a single SSE connection is held before it
#   returns and the browser EventSource reconnects (bounds thread hold time).
REPLAY_GW_THREADS=64
REPLAY_SSE_MAX_STREAMS=32
REPLAY_SSE_MAX_DURATION_S=30

# --- PostgreSQL ---
BACKTEST_POSTGRES_DSN=postgresql://cex:cex@postgres:5432/cex
LEDGER_POSTGRES_DSN=postgresql://cex:cex@postgres:5432/cex
# F-12 IN-008 PR-F12-3a: Venues service needs PG access for hedgeflows + child_orders.
VENUES_POSTGRES_DSN=postgresql://cex:cex@postgres:5432/cex
# PR-F02-001: order_flow persists accepted FlowOrders to flow_orders +
# flow_order_legs (status='active') so F-04 matching's PG reader picks
# them up. Without this DSN, order_flow keeps the in-memory + Kafka-only
# path and matching's PG reader (MATCHING_POSTGRES_DSN below) sees an
# empty flow_orders → zero batches with active flow.
ORDER_FLOW_POSTGRES_DSN=postgresql://cex:cex@postgres:5432/cex
# Enabling MATCHING_POSTGRES_DSN switches matching to PG-sourced flow
# orders. Pairs with ORDER_FLOW_POSTGRES_DSN above; leave both set or
# both empty.
MATCHING_POSTGRES_DSN=postgresql://cex:cex@postgres:5432/cex
# F-06 (T-F06-031): risk reads positions/accounts/risk_limits and writes
# risk_snapshots for post-trade margin. Without this DSN risk runs in degraded
# mode (no margin snapshots, GetRiskSnapshot returns empty).
RISK_POSTGRES_DSN=postgresql://cex:cex@postgres:5432/cex
# F-06: default role used to resolve margin rates from risk_limits when no
# per-user limit row exists (seed has role 'demo' and 'client').
RISK_DEFAULT_ROLE=client
# ADR-045: размеры пулов PG-соединений (per-service). Сумма по сервисам должна
# укладываться в postgres max_connections (см. docker-compose.dev.yml command).
LEDGER_PG_POOL_SIZE=16
RISK_PG_POOL_SIZE=16

# --- Services ports/addresses (docker-compose uses service DNS names) ---
GATEWAY_HTTP_PORT=8080

ORDER_FLOW_GRPC_LISTEN=0.0.0.0:50051
ORDER_FLOW_GRPC_ADDR=order_flow:50051

RISK_GRPC_LISTEN=0.0.0.0:50052
RISK_GRPC_ADDR=risk:50052

LEDGER_GRPC_LISTEN=0.0.0.0:50053
LEDGER_GRPC_ADDR=ledger:50053

MARKET_DATA_GRPC_LISTEN=0.0.0.0:50054
MARKET_DATA_GRPC_ADDR=market_data:50054
MARKET_DATA_GRPC_TARGET=market_data:50054

# Market Data -> ClickHouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=default
CLICKHOUSE_BATCHRESULTS_TABLE=batchresults
CLICKHOUSE_FILLS_TABLE=fills
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TIMEOUT_MS=3000

# Backtest -> ClickHouse (reads production history; stores replay logs)
# IN-007 BUG-2 part 2: backtest must write to its OWN tables, not the
# live `batchresults`/`fills` tables that cpp/market_data populates.
# Otherwise both services INSERT each live batch → 2 rows per batch in
# `fills` (verified 2026-05-22: 70 rows for 35 batches). Replay/quality
# consumers must opt-in to read from these tables explicitly.
BACKTEST_METRICS_PORT=8087
BACKTEST_CLICKHOUSE_URL=http://clickhouse:8123
BACKTEST_CLICKHOUSE_DB=default
BACKTEST_CLICKHOUSE_BATCHRESULTS_TABLE=backtest_batchresults
BACKTEST_CLICKHOUSE_FILLS_TABLE=backtest_fills
BACKTEST_CLICKHOUSE_USER=default
BACKTEST_CLICKHOUSE_PASSWORD=
BACKTEST_CLICKHOUSE_TIMEOUT_MS=3000

# F-20 auto SimSession on venues startup.
# Empty (default) = require explicit operator activation via REST/UI.
# Set to SIM_ONLY for "safe by default" — all matching child orders routed
# to the simulator against the live LOB; nothing reaches real exchanges
# unless this is cleared (or the operator Completes the auto session).
# SHADOW = dual-send (live + sim parallel; LIVE actually trades).
# LIVE_ONLY = no-op default (kept for symmetry).
VENUES_AUTO_SIM_MODE=
VENUES_AUTO_SIM_NAME=auto-default
VENUES_AUTO_SIM_SCOPE_VENUES=
VENUES_AUTO_SIM_SCOPE_INSTRUMENTS=
VENUES_AUTO_SIM_STALE_LOB_THRESHOLD_MS=600000

# Matching / external venue cadence
BATCH_INTERVAL_MS=5000
VENUES_MD_LOOP_INTERVAL_MS=5000
LOB_TO_FOB_TAU_SEC=5
# Стартовый порог устаревания venue-снапшота. В runtime переопределяется из UI
# (вкладка Площадки → f05a_clearing_config.venue_stale_ms, venues поллит TTL 3с).
# При N реальных венью цикл md_publish_loop растёт (~68с на 5 венью), порог должен
# его превышать, иначе кривые пропускаются как stale.
STALE_THRESHOLD_MS=15000
MATCHING_METRICS_PORT=8081

# External venue stability
CIRCUIT_BREAKER_ERRORS=3
CIRCUIT_BREAKER_WINDOW_S=60
CIRCUIT_BREAKER_COOLDOWN_S=10
CEX_RECONNECT_COOLDOWN_MS=10000
CEX_HEARTBEAT_PONG_TIMEOUT_MS=15000
CEX_REST_TIMEOUT_MS=5000
CEX_REST_TICKER_VOLUME_ENABLED=1
DEX_POLLING_INTERVAL_FAST_MS=5000
DEX_POLLING_INTERVAL_SLOW_MS=15000
DEX_RECONNECT_COOLDOWN_MS=10000
DEX_HEARTBEAT_PONG_TIMEOUT_MS=15000
DEX_RPC_TIMEOUT_MS=5000

# External order execution is simulated by default in real venue modes.
# Set these to 0 only when intentionally using a sandbox/testnet connector.
VENUES_SIMULATE_ORDERS=1
CEX_SIMULATE_ORDERS=1
DEX_SIMULATE_ORDERS=1
# ADR-060: реалистичная симуляция исполнения — sim-заявка матчится против ленты РЕАЛЬНЫХ
# публичных сделок (SELL@P против price>=P, BUY@P против price<=P; partial по объёму; VWAP
# реальных сделок; нет пересечения ⇒ не исполнена). 0 = прежний мгновенный филл по limit.
VENUES_SIM_MATCH_REAL_TRADES=0
VENUES_SIM_TRADE_WINDOW_MS=10000

# LOB -> FOB curve degradation defaults. Values are in bps for the confidence model.
CURVE_EPSILON1_GREEN_BPS=25
CURVE_EPSILON2_GREEN_BPS=5
CURVE_EPSILON3_GREEN_BPS=25
CURVE_MIN_L3_CONFIDENCE=0.35
CURVE_MIN_L2_CONFIDENCE=0.10
CURVE_MIN_L1_CONFIDENCE=0.01
CURVE_L3_NO_EXEC_CONFIDENCE_MULTIPLIER=0.85

# --- F-12 hedge trigger / execution intent config (PR-F12-5) ---
# Defaults of 0 disable the trigger entirely; set per-symbol values below.
# qty is in base units (e.g. BTC), notional is in quote units (e.g. USDT).
HEDGE_TRIGGER_QTY_DEFAULT=0
HEDGE_TRIGGER_NOTIONAL_DEFAULT=0
HEDGE_TRIGGER_SYMBOLS=BTC/USDT,ETH/USDT
# Dev thresholds intentionally low so PR-F12-5 hedge intents fire on the
# demo order book. Production deployments should raise these significantly
# (e.g. qty=0.5 BTC, notional=20000 USDT).
HEDGE_TRIGGER_QTY_BTC_USDT=0.001
HEDGE_TRIGGER_NOTIONAL_BTC_USDT=10
HEDGE_TRIGGER_QTY_ETH_USDT=0.01
HEDGE_TRIGGER_NOTIONAL_ETH_USDT=10

# Execution intent config for real F-12 hedge intents (BuildFromHedgeTriggerDecisions).
# URGENCY: LOW | MEDIUM | HIGH ; STRATEGY: MARKET | LIMIT | TWAP | POST_ONLY ; TIF: IOC | GTC | FOK
HEDGE_INTENT_URGENCY=MEDIUM
HEDGE_INTENT_STRATEGY=MARKET
HEDGE_INTENT_TIF=IOC
HEDGE_INTENT_TIMEOUT_MS=30000
HEDGE_INTENT_MAX_SLIPPAGE_BPS=50
HEDGE_INTENT_ALLOWED_VENUES=binance,coinbase,kraken,okx,uniswap_v3

# --- F-18 CE Treasury: capital, net position & position-based hedge (ADR-054) ---
# Единая книга holdings биржи CE. pos_a = balance − target; хедж по net-позиции
# сверх порога θ_a (не per-segment gross). Всё за флагом; default off = поведение
# до-F18 (legacy per-segment ADR-049). read-side отображается на /ce-capital-live.
CE_NET_HEDGE_ENABLED=0
# Phase E02 (эмиссия net-хеджа из risk): период драйвера и cooldown per-currency
# (защита от переэмиссии, пока хедж исполняется), список venue для роутинга.
CE_HEDGE_INTERVAL_MS=10000
CE_HEDGE_COOLDOWN_MS=30000
CE_HEDGE_ALLOWED_VENUES=binance,okx
CE_NUMERAIRE=USDT
# CE_HEDGE_MODE: FLATTEN (позиция → 0) | TO_BAND (до края θ)
CE_HEDGE_MODE=FLATTEN
# Seed капитала (единая книга holdings), одна на актив. Пусто/0 = не seeded.
CE_CAPITAL_SEED_BTC=10
CE_CAPITAL_SEED_ETH=100
CE_CAPITAL_SEED_SOL=1000
CE_CAPITAL_SEED_USDT=1000000
# Порог θ_a хеджа (в base-единицах актива). Пусто = ∞ (актив не хеджируется).
CE_HEDGE_THRESHOLD_BTC=0.25
CE_HEDGE_THRESHOLD_ETH=2
CE_HEDGE_THRESHOLD_SOL=10
# reference-quote для хедж-инструмента a/QUOTE_ref (default = CE_NUMERAIRE)
CE_HEDGE_QUOTE_REF_BTC=USDT
CE_HEDGE_QUOTE_REF_ETH=USDT
CE_HEDGE_QUOTE_REF_SOL=USDT
# Опц. риск-лимиты от капитала: θ=min(θ_abs, κ·Equity/mark); жёсткий inventory cap.
CE_HEDGE_EQUITY_FRACTION=0
# CE_MAX_POSITION_BTC=

# --- F-05A CE-агенты (ADR-055/056/057, вариант A) ---
# matching читает плечи ПЕРЕВОДА (связка-арбитражёр) и ЗАПАСА (собственная книга) по активу
# из env (капитал/риск); quote-переводчики и марки приходят из market_data (ce.clearing.input).
# α — глубина (тыс. USDT на ‰), c — мёртвая зона (‰). Дефолты — по Python-эталону.
CE_AGENTS_ENABLED=0
CE_TRANSFER_ALPHA_BTC=12
CE_TRANSFER_C_BTC=0.25
CE_STOCK_ALPHA_BTC=8
CE_STOCK_C_BTC=0.15
# ETH/SOL: без плеч перевода/запаса узлы актива РАЗОРВАНЫ между venue и не держат
# книгу ⇒ баланс Wx=0 форсит поток f=0 (позиция всегда 0). Задаём плечи, чтобы
# ETH/SOL тоже клирились (иначе торгуется только BTC — см. bug 2026-09-14).
CE_TRANSFER_ALPHA_ETH=12
CE_TRANSFER_C_ETH=0.25
CE_STOCK_ALPHA_ETH=8
CE_STOCK_C_ETH=0.15
CE_TRANSFER_ALPHA_SOL=12
CE_TRANSFER_C_SOL=0.25
CE_STOCK_ALPHA_SOL=8
CE_STOCK_C_SOL=0.15
CE_TRANSFER_ALPHA_USDT=18
CE_TRANSFER_C_USDT=0.05
CE_STOCK_ALPHA_USDT=60
CE_STOCK_C_USDT=0.02
# ADR-057: фильтр тонких/выбросных venue в CE-клиринге — агент с глубиной < ratio·max
# по активу исключается (тонкие venue дают выбросные цены → fake-арбитраж → раздувание).
CE_MIN_DEPTH_RATIO=0.01
# Форс-кип venue (comma) — оставить в клиринге мимо фильтра тонких. Для DEX
# (uniswap_v3): реальный расходящийся источник CEX↔DEX арбитража, НЕ выброс
# (coinbase-выброс фильтр по-прежнему выкидывает). Пусто = только фильтр по глубине.
CE_FORCE_KEEP_VENUES=
# ADR-064: переводчик обобщается с пары base/numeraire на ЛЮБУЮ пару base/quote —
# прямые кросс-пары (напр. ETH/BTC) тоже дают агентов, а не только X/USDT.
# default OFF = прежнее поведение (только base/numeraire), регрессия.
CE_CROSS_PAIRS=0

# --- F-18 v2 (ADR-061, T-F18-103): граф CE без STOCK-плеч/узла-склада ---
# CE_V2_GRAPH=1 переключает matching на AssembleCeGraphV2: только узлы asset@venue +
# house-столбец (единственный зафиксированный узел numeraire@CE_HOUSE_VENUE, π=0).
# Плечи перевода (CE_TRANSFER_ALPHA_*/CE_TRANSFER_C_*) переиспользуются как в v1;
# CE_STOCK_ALPHA_*/CE_STOCK_C_* в v2-ветке НЕ читаются (плечо запаса убрано, ADR-061 §1).
CE_V2_GRAPH=0
# Площадка house-узла (должна быть ∈ CE_VENUES/venues из ce.clearing.input); пусто ⇒
# берётся первая площадка списка venues (matching_loop сам проверяет house_venue ∈ venues,
# при рассинхроне — WARN + такт пропускается, см. T-F18-103).
CE_HOUSE_VENUE=

# --- F-12 DoD-3: Pre-hedge risk check thresholds (PR-F12-13) ---
# Risk Manager applies these in fixed order on RiskService.PreHedgeCheck:
#   1. PROVIDER_HALTED       (kill-switch state, no env knob — gRPC-controlled)
#   2. NOTIONAL_EXCEEDED     RISK_HEDGE_MAX_NOTIONAL (target_qty * reference_mid)
#   3. EXPOSURE_EXCEEDED     RISK_HEDGE_EXPOSURE_LIMIT (cumulative |position|)
#   4. SLIPPAGE_EXCEEDED     RISK_HEDGE_MAX_SLIPPAGE_<URGENCY>_BPS
#   5. VENUES_UNAVAILABLE    (computed from venue.health, no env)
#
# Defaults of 0 disable the corresponding check.
RISK_HEDGE_MAX_NOTIONAL=100000
RISK_HEDGE_EXPOSURE_LIMIT=5.0
RISK_HEDGE_MAX_SLIPPAGE_LOW_BPS=20
RISK_HEDGE_MAX_SLIPPAGE_MEDIUM_BPS=50
RISK_HEDGE_MAX_SLIPPAGE_HIGH_BPS=150
