# --- Kafka/Redpanda ---
KAFKA_BROKERS=redpanda:9092
REPLAY_COMMANDS_TOPIC=replay.commands
REPLAY_RESULTS_TOPIC=replay.results

# --- PostgreSQL ---
BACKTEST_POSTGRES_DSN=postgresql://cex:cex@postgres:5432/cex
LEDGER_POSTGRES_DSN=postgresql://cex:cex@postgres:5432/cex
# F-12 IN-008 PR-F12-3a: Venues service needs PG access for hedgeflows + child_orders.
VENUES_POSTGRES_DSN=postgresql://cex:cex@postgres:5432/cex

# --- Services ports/addresses (docker-compose uses service DNS names) ---
GATEWAY_HTTP_PORT=8080

ORDER_FLOW_GRPC_LISTEN=0.0.0.0:50051
ORDER_FLOW_GRPC_ADDR=order_flow:50051

RISK_GRPC_LISTEN=0.0.0.0:50052
RISK_GRPC_ADDR=risk:50052

LEDGER_GRPC_LISTEN=0.0.0.0:50053
LEDGER_GRPC_ADDR=ledger:50053

MARKET_DATA_GRPC_LISTEN=0.0.0.0:50054
MARKET_DATA_GRPC_ADDR=market_data:50054
MARKET_DATA_GRPC_TARGET=market_data:50054

# Market Data -> ClickHouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=default
CLICKHOUSE_BATCHRESULTS_TABLE=batchresults
CLICKHOUSE_FILLS_TABLE=fills
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_TIMEOUT_MS=3000

# Backtest -> ClickHouse (reads production history; stores replay logs)
# IN-007 BUG-2 part 2: backtest must write to its OWN tables, not the
# live `batchresults`/`fills` tables that cpp/market_data populates.
# Otherwise both services INSERT each live batch → 2 rows per batch in
# `fills` (verified 2026-05-22: 70 rows for 35 batches). Replay/quality
# consumers must opt-in to read from these tables explicitly.
BACKTEST_METRICS_PORT=8087
BACKTEST_CLICKHOUSE_URL=http://clickhouse:8123
BACKTEST_CLICKHOUSE_DB=default
BACKTEST_CLICKHOUSE_BATCHRESULTS_TABLE=backtest_batchresults
BACKTEST_CLICKHOUSE_FILLS_TABLE=backtest_fills
BACKTEST_CLICKHOUSE_USER=default
BACKTEST_CLICKHOUSE_PASSWORD=
BACKTEST_CLICKHOUSE_TIMEOUT_MS=3000

# Matching / external venue cadence
BATCH_INTERVAL_MS=5000
VENUES_MD_LOOP_INTERVAL_MS=5000
LOB_TO_FOB_TAU_SEC=5
STALE_THRESHOLD_MS=15000
MATCHING_METRICS_PORT=8081

# External venue stability
CIRCUIT_BREAKER_ERRORS=3
CIRCUIT_BREAKER_WINDOW_S=60
CIRCUIT_BREAKER_COOLDOWN_S=10
CEX_RECONNECT_COOLDOWN_MS=10000
CEX_HEARTBEAT_PONG_TIMEOUT_MS=15000
CEX_REST_TIMEOUT_MS=5000
CEX_REST_TICKER_VOLUME_ENABLED=1
DEX_POLLING_INTERVAL_FAST_MS=5000
DEX_POLLING_INTERVAL_SLOW_MS=15000
DEX_RECONNECT_COOLDOWN_MS=10000
DEX_HEARTBEAT_PONG_TIMEOUT_MS=15000
DEX_RPC_TIMEOUT_MS=5000

# External order execution is simulated by default in real venue modes.
# Set these to 0 only when intentionally using a sandbox/testnet connector.
VENUES_SIMULATE_ORDERS=1
CEX_SIMULATE_ORDERS=1
DEX_SIMULATE_ORDERS=1

# LOB -> FOB curve degradation defaults. Values are in bps for the confidence model.
CURVE_EPSILON1_GREEN_BPS=25
CURVE_EPSILON2_GREEN_BPS=5
CURVE_EPSILON3_GREEN_BPS=25
CURVE_MIN_L3_CONFIDENCE=0.35
CURVE_MIN_L2_CONFIDENCE=0.10
CURVE_MIN_L1_CONFIDENCE=0.01
CURVE_L3_NO_EXEC_CONFIDENCE_MULTIPLIER=0.85

# --- F-12 hedge trigger / execution intent config (PR-F12-5) ---
# Defaults of 0 disable the trigger entirely; set per-symbol values below.
# qty is in base units (e.g. BTC), notional is in quote units (e.g. USDT).
HEDGE_TRIGGER_QTY_DEFAULT=0
HEDGE_TRIGGER_NOTIONAL_DEFAULT=0
HEDGE_TRIGGER_SYMBOLS=BTC/USDT,ETH/USDT
# Dev thresholds intentionally low so PR-F12-5 hedge intents fire on the
# demo order book. Production deployments should raise these significantly
# (e.g. qty=0.5 BTC, notional=20000 USDT).
HEDGE_TRIGGER_QTY_BTC_USDT=0.001
HEDGE_TRIGGER_NOTIONAL_BTC_USDT=10
HEDGE_TRIGGER_QTY_ETH_USDT=0.01
HEDGE_TRIGGER_NOTIONAL_ETH_USDT=10

# Execution intent config for real F-12 hedge intents (BuildFromHedgeTriggerDecisions).
# URGENCY: LOW | MEDIUM | HIGH ; STRATEGY: MARKET | LIMIT | TWAP | POST_ONLY ; TIF: IOC | GTC | FOK
HEDGE_INTENT_URGENCY=MEDIUM
HEDGE_INTENT_STRATEGY=MARKET
HEDGE_INTENT_TIF=IOC
HEDGE_INTENT_TIMEOUT_MS=30000
HEDGE_INTENT_MAX_SLIPPAGE_BPS=50
HEDGE_INTENT_ALLOWED_VENUES=binance,coinbase,uniswap_v3

# --- F-12 DoD-3: Pre-hedge risk check thresholds (PR-F12-13) ---
# Risk Manager applies these in fixed order on RiskService.PreHedgeCheck:
#   1. PROVIDER_HALTED       (kill-switch state, no env knob — gRPC-controlled)
#   2. NOTIONAL_EXCEEDED     RISK_HEDGE_MAX_NOTIONAL (target_qty * reference_mid)
#   3. EXPOSURE_EXCEEDED     RISK_HEDGE_EXPOSURE_LIMIT (cumulative |position|)
#   4. SLIPPAGE_EXCEEDED     RISK_HEDGE_MAX_SLIPPAGE_<URGENCY>_BPS
#   5. VENUES_UNAVAILABLE    (computed from venue.health, no env)
#
# Defaults of 0 disable the corresponding check.
RISK_HEDGE_MAX_NOTIONAL=100000
RISK_HEDGE_EXPOSURE_LIMIT=5.0
RISK_HEDGE_MAX_SLIPPAGE_LOW_BPS=20
RISK_HEDGE_MAX_SLIPPAGE_MEDIUM_BPS=50
RISK_HEDGE_MAX_SLIPPAGE_HIGH_BPS=150
