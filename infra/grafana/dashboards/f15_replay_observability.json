{
  "title": "F15 Replay Observability",
  "uid": "f15-replay-observability",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "History Load p95",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(backtest_replay_history_load_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Batch Latency p95 / Solve Time p95",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(backtest_replay_batch_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "batch p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(backtest_replay_solve_time_ms_bucket[$__rate_interval])))",
          "legendFormat": "solve p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Progress Lag p95",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(backtest_replay_progress_lag_ms_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ClickHouse Insert p95 by Table",
      "gridPos": { "x": 0, "y": 7, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (table, le) (rate(backtest_replay_clickhouse_insert_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kafka Publish Errors",
      "gridPos": { "x": 8, "y": 7, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum by (topic) (increase(backtest_replay_kafka_publish_total{result=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Soft / Hard Failures by Component",
      "gridPos": { "x": 16, "y": 7, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum by (failure_type, component) (increase(backtest_replay_failures_total[$__rate_interval]))",
          "legendFormat": "{{failure_type}} {{component}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Active Shadow Namespaces",
      "gridPos": { "x": 0, "y": 14, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "backtest_replay_shadow_namespaces_active"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Shadow Namespace Init Outcomes",
      "gridPos": { "x": 6, "y": 14, "w": 9, "h": 6 },
      "targets": [
        {
          "expr": "sum by (result) (increase(backtest_replay_shadow_namespace_init_total[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Loaded Rows",
      "gridPos": { "x": 15, "y": 14, "w": 9, "h": 6 },
      "targets": [
        {
          "expr": "rate(backtest_replay_batches_loaded_total[$__rate_interval])",
          "legendFormat": "batches"
        },
        {
          "expr": "rate(backtest_replay_fills_loaded_total[$__rate_interval])",
          "legendFormat": "fills"
        },
        {
          "expr": "rate(backtest_replay_snapshots_loaded_total[$__rate_interval])",
          "legendFormat": "snapshots"
        }
      ]
    }
  ]
}
